# Host build output must never enter the image build context. `COPY . .` would
# otherwise overwrite the Alpine-installed node_modules with Windows-native
# binaries (notably lightningcss-win32-x64-msvc), breaking `npm run build`
# inside the container. CI only escapes this because a fresh runner checkout
# has no node_modules.
node_modules
dist
.git
*.tsbuildinfo
