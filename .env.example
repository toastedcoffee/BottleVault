# Database password (required)
DB_PASSWORD=your-secure-password-here

# JWT Secret — must be at least 32 characters (required)
# Generate one with: openssl rand -base64 64
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long

# Registration (set to false after creating your account)
REGISTRATION_ENABLED=true

# Port to expose the web UI on (default: 80)
# PORT=80

# Where nginx writes its access and error logs on the host (default:
# ./data/logs/nginx). The access log records request line, status, referer,
# user-agent and Cloudflare's two-letter country header, with no IP addresses.
# Error-log lines can include a client address — see DEPLOY.md.
# WEB_LOG_PATH=./data/logs/nginx

# Enable Swagger API docs (default: false, only enable for development)
# SWAGGER_ENABLED=true

# AGPL section 13 source offer (building from source only; ignored when running
# prebuilt images). Leave both unset if you run BottleVault unmodified.
#
# If you MODIFY the code and other people use your instance over a network, the
# licence obliges you to offer them YOUR source. Set both together — SOURCE_URL
# alone links to your repo root, but GIT_SHA alone pins your commit against the
# upstream repository, which 404s. Only pin from a clean tree; verify with
# `test -z "$(git status --porcelain)"` first.
# SOURCE_URL=https://github.com/your-account/your-fork
# GIT_SHA=

# Cloudflare Tunnel (docker-compose.prod.yml only).
# Create at: https://one.dash.cloudflare.com → Networks → Tunnels
# Required by docker-compose.prod.yml — for LAN-only deployments, delete the
# tunnel service block from that file instead of setting this.
# TUNNEL_TOKEN=your-tunnel-token

# Comma-separated allowed origins for CORS (e.g. https://cellar.bottlevault.app)
# Only needed when using Cloudflare Tunnel or custom domain.
# Multiple: ALLOWED_ORIGINS=https://cellar.bottlevault.app,https://bottlevault.app
# ALLOWED_ORIGINS=https://cellar.bottlevault.app
