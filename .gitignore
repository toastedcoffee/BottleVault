# IDE
*.iml
.idea/
.vscode/
.DS_Store

# Backend
backend/build/
backend/.gradle/
backend/out/
backend/uploads-dev/
backend/local.properties

# Frontend
# Unanchored: a .gitignore pattern with no mid-string slash matches at ANY
# depth, so this one rule covers frontend/node_modules/ and a stray repo-root
# node_modules/ (left behind by an npm/npx run from the wrong directory).
# Deliberately NOT mirroring the root .dockerignore, which needs both
# `node_modules` and `**/node_modules`: dockerignore anchors every pattern at
# the context root, git does not.
node_modules/
frontend/dist/
frontend/.cache/
*.tsbuildinfo

# Claude Code session files
.claude/

# Cloud-sync temp files (Google Drive)
.tmp.driveupload/

# Environment
.env
*.env.local

# Runtime data (docker-compose bind mounts)
data/

# OS
Thumbs.db
*.swp
*.swo

# Local-only reports (not for the public repo)
DEPENDENCY_AUDIT.md

# Local-only Claude notes (never for the public repo)
CLAUDE.local.md

# Implementation plans — working notes, and they describe the maintainer's
# private infrastructure. Scoped to docs/superpowers/ so genuine user-facing
# docs can still live under docs/.
docs/superpowers/
